{
  "name": "collezione-euro",
  "version": "1.0.0",
  "private": true,
  "description": "Eurodex – catalogo delle monete euro da circolazione",
  "type": "module",
  "scripts": {
    "catalogo": "node scripts/fetch-catalog.mjs",
    "prova": "PROBE=1 node scripts/fetch-catalog.mjs",
    "build": "rm -rf www/build && vite build",
    "dev": "vite",
    "tipi": "tsc",
    "lint": "eslint .",
