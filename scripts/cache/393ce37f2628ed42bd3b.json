7-original.jpg","thumbnail":"https://en.numista.com/catalogue/photos/pays-bas/66b31a505487b7.87035197-180.jpg","picture_copyright":"brismike","picture_license_name":"CC BY-NC","picture_license_url":"https://creativecommons.org/licenses/by-nc/4.0/deed.it"},"series":"EU Flag","commemorated_topic":"30° anniversario della bandiera dell'Unione europea","comments":"Carta da gioco<br />\r\n<a href=\"https://en.numista.com/catalogue/images/563cf8c7761c0.jpg\"><img src=\"https://en.numista.com/catalogue/images/miniatures/563cf8c7761c0.jpg\" alt=\"\" width=\"157\" height=\"200\" /></a>","tags":["Carta geografica","Bandiera"],"references":[{"catalogue":{"id":3,"code":"KM"},"number":"357"},{"catalogue":{"id":24,"code":"Schön"},"number":"239"}],"weight":8.5,"orientation":"medal","edge":{"description":"Ansa con iscrizione","lettering":"GOD * ZIJ * MET * ONS","lettering_scripts":[{"name":"Latino"}],"picture":"https://en.numista.com/catalogue/photos/pays-bas/696f0fdddcf062.44790028-original.jpg","thumbnail":"https://en.numista.com/catalogue/photos/pays-bas/696f0fdddcf062.44790028-180.jpg","picture_copyright":"Cyrillius"},"mints":[{"id":23,"name":"Royal Dutch Mint"}],"category":"coin","type":"Moneta di circolazione commemorativa"}}