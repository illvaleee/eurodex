:[{"name":"Latino"}],"picture":"https://en.numista.com/catalogue/photos/monaco/690e43567ba800.81848677-original.jpg","thumbnail":"https://en.numista.com/catalogue/photos/monaco/690e43567ba800.81848677-180.jpg","picture_copyright":"albinh","picture_license_name":"CC BY-NC-SA","picture_license_url":"https://creativecommons.org/licenses/by-nc-sa/4.0/deed.it"},"commemorated_topic":"Marchesato di Baux","tags":["Castello o fortificazione","Carta geografica"],"references":[{"catalogue":{"id":2884,"code":"Gad Euro"},"number":"MC221"}],"weight":8.5,"orientation":"medal","edge":{"description":"La sequenza \"2 ★ ★\" ripetuta sei volte alternativamente in verticale e invertita","lettering":"2★★2★★2★★2★★2★★2★★","picture":"https://en.numista.com/catalogue/photos/monaco/6969f602cc8470.67353099-original.jpg","thumbnail":"https://en.numista.com/catalogue/photos/monaco/6969f602cc8470.67353099-180.jpg","picture_copyright":"albinh","picture_license_name":"CC BY-NC-SA","picture_license_url":"https://creativecommons.org/licenses/by-nc-sa/4.0/deed.it"},"mints":[{"id":14,"name":"Monnaie de Paris"}],"category":"coin","type":"Moneta non in circolazione"}}