rules_version = '2';
// Stessa collezione su più dispositivi: ogni collezione sta in collezioni/{uid}, dove uid è l'utente di
// Firebase legato all'account Google con cui si accede nell'app. Solo chi ha fatto l'accesso con quel
// account può leggerla o modificarla; nessuno può elencare o cancellare le collezioni.
//
// Accesso solo su approvazione (docs/progetto-accesso-su-approvazione.md): ogni accesso con Google nell'app è un
// tentativo (accessi/{uid}/tentativi); la funzione tentativoDiAccesso crea la richiesta dell'account nuovo
// (accessi/{uid}, "in_attesa") e solo Valerio la accetta o la rifiuta. Il muro lo accende Valerio dall'app
// (config/accesso, "obbligatorio"): da quel momento le collezioni sono solo per gli account approvati. Con il muro
// spento le usano tutti, tranne gli account rifiutati o a cui Valerio ha tolto l'accesso (sua scelta, 21/11).
service cloud.firestore {
  match /databases/{database}/documents {
    function mia(uid) { return request.auth != null && request.auth.uid == uid; }

    // solo account Google: se un giorno si accendesse per sbaglio un altro metodo di accesso, non aprirebbe niente
    function conGoogle() { return request.auth.token.firebase.sign_in_provider == 'google.com'; }

    // Valerio, l'unico amministratore. L'UID identifica, non autorizza: non è un segreto.
    function admin() {
      return request.auth != null && request.auth.uid == 'AkUbMzxnXwgjinx9fMaWw6NBAlM2'
        && request.auth.token.email_verified == true && conGoogle();
    }

    // il muro: acceso solo quando Valerio lo accende dall'app (config/accesso). Senza quel documento, o con
    // "obbligatorio" diverso da true, tutto funziona come prima
    function accessoObbligatorio() {
      return exists(/databases/$(database)/documents/config/accesso)
        && get(/databases/$(database)/documents/config/accesso).data.get('obbligatorio', false) == true;
    }

    // lo stato dell'account si legge a ogni richiesta: una revoca ha effetto subito
    function conRichiesta(uid) { return exists(/databases/$(database)/documents/accessi/$(uid)); }
    function statoDi(uid) { return get(/databases/$(database)/documents/accessi/$(uid)).data.get('stato', ''); }

    function approvato() {
      return request.auth != null && conGoogle()
        && conRichiesta(request.auth.uid) && statoDi(request.auth.uid) == 'approvato';
    }

    // rifiutato, o con l'accesso tolto: fuori anche con il muro spento
    function escluso(uid) { return conRichiesta(uid) && statoDi(uid) in ['rifiutato', 'revocato']; }

    // l'ora dell'ultimo tentativo, scritta dalla funzione tentativoDiAccesso (le richieste che non ce l'hanno contano
    // come vecchie). Limite di costo, non di sicurezza: un tentativo ogni 20 secondi per account (revisione di Claude 2)
    function ultimoTentativo(uid) {
      return get(/databases/$(database)/documents/accessi/$(uid)).data.get('ultimoTentativo', timestamp.value(0));
    }
    function tentativoRecente(uid) {
      return conRichiesta(uid) && request.time < ultimoTentativo(uid) + duration.value(20, 's');
    }

    // muro acceso: solo gli approvati (e Valerio); muro spento: tutti tranne gli esclusi
    function puoUsare(uid) {
      return mia(uid) && (admin() || approvato() || (!accessoObbligatorio() && !escluso(uid)));
    }

    // l'interruttore del muro: lo legge chiunque, anche prima di accedere (l'app deve sapere se mostrare il muro;
    // dice solo sì o no), lo cambia solo Valerio
    match /config/accesso {
      allow get: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['obbligatorio', 'cambiato'])
        && request.resource.data.obbligatorio is bool
        && request.resource.data.cambiato == request.time;
      allow list, delete: if false;
    }

    match /accessi/{uid} {
      // la richiesta la crea solo la funzione tentativoDiAccesso (con nome ed email veri, da Authentication)
      allow create: if false;
      allow get: if mia(uid) || admin();
      allow list, delete: if admin();
      // solo Valerio decide: cambia lo stato (e la sua nota), il resto della richiesta resta com'è
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'decisione', 'nota'])
        && request.resource.data.stato in ['in_attesa', 'approvato', 'rifiutato', 'revocato']
        && request.resource.data.decisione == request.time
        && (!('nota' in request.resource.data)
            || (request.resource.data.nota is string && request.resource.data.nota.size() <= 200));

      // un tentativo di accesso (ogni accesso con Google nell'app): lo scrive l'account stesso, con il solo telefono
      // (nome ed email la funzione li prende da Authentication); lo legge e lo cancella solo la funzione
      match /tentativi/{tid} {
        allow create: if mia(uid) && conGoogle() && !tentativoRecente(uid)
          && request.resource.data.keys().hasOnly(['quando', 'dispositivo', 'motivo'])
          && request.resource.data.quando == request.time
          // il telefono è solo un aiuto: niente @ (servirebbe a fingersi qualcun altro), niente caratteri di
          // controllo o di direzione del testo, al massimo 80 caratteri
          && request.resource.data.dispositivo is string
          && request.resource.data.dispositivo.matches('[^@\\p{Cc}\\p{Cf}]{0,80}')
          && request.resource.data.motivo in ['accesso', 'ancora', 'primo'];
        allow read, update, delete: if false;
      }

      // i dispositivi di un account (per le notifiche): li gestisce solo l'account stesso, qualunque sia il suo stato
      // (anche chi è stato rifiutato deve poter sapere se Valerio poi lo approva). Il server decide cosa mandare:
      // un account escluso non può scrivere eventi di sincronizzazione
      match /dispositivi/{did} {
        allow get, list, delete: if mia(uid) && conGoogle();
        allow create, update: if mia(uid) && conGoogle() && did.matches('^[A-Za-z0-9_-]{8,64}$')
          && request.resource.data.keys().hasOnly(['token', 'nome', 'aggiornato'])
          && request.resource.data.token is string && request.resource.data.token.size() <= 4096
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
          && request.resource.data.aggiornato == request.time;
      }
    }

    match /collezioni/{uid} {
      allow get, create, update: if puoUsare(uid);
      allow list, delete: if false;
      // formato attuale: le voci della collezione (monete, preferite, note) con l'istante dell'ultima modifica,
      // divise in pochi documenti (possedute in 16 parti, preferite, note in 4 parti)
      match /voci/{doc} {
        allow read: if puoUsare(uid);
        allow create, update: if puoUsare(uid) && doc.matches('^(p[0-9a-f]|f|n[0-3])$')
          && request.resource.data.keys().hasOnly(['e']) && request.resource.data.e is map;
        allow delete: if false;
      }
      // formato delle versioni fino alla 1.0.78 (ancora letto e scritto finché tutti non aggiornano)
      match /stato/{doc} {
        allow read, write: if puoUsare(uid) && doc in ['possedute', 'preferiti', 'note'];
      }
      match /dispositivi/{did} {
        allow read, write: if puoUsare(uid);
        // Valerio vede su quali telefoni è collegato ogni account e quando l'ha aperto l'ultima volta
        allow get, list: if admin();
      }
      match /eventi/{eid} {
        allow create: if puoUsare(uid) && request.resource.data.testo is string && request.resource.data.testo.size() < 600;
        allow read, update, delete: if false;
      }
    }
  }
}
